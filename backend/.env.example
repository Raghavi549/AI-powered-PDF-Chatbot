# Copy this file to .env (which is git-ignored) and fill in real values.
# Never commit .env or put real credentials in this file.

# Groq Cloud API key. Optional in this stage: the backend starts without it
# and /api/health reports groq_configured=false. Leave empty until you have a
# key, then paste it here (an empty value counts as "not configured").
GROQ_API_KEY=

# The single browser origin allowed to call this API (CORS). Must be a specific
# origin, never "*". Must match the address you open the frontend at.
FRONTEND_ORIGIN=http://localhost:5173
